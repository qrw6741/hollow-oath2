script = ExtResource("1_item")
id = &"hollow_sigil"
display_name = "Hollowmere Sigil"
description = "A Candlewright's wax seal, pressed with a candle and a broken crown. Hold it up and the oath folds the road: it carries you to Hollowmere Manor, and, used there, back to the very spot you left. It cannot be used in the middle of a boss fight."
