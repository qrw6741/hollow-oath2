[resource]
script = ExtResource("1_preset")
id = &"unsworn"
display_name = "The Unsworn"
tagline = "No oath. No armour. Only fists."
description = "You never swore, so nothing holds you. No armour, no weapon: wrapped fists, a fast flurry of jabs, and a punishing counter. Every blow you take, you feel."
weapon = ExtResource("2_weapon")
armor_name = "Bone-cloth Wraps"
armor_description = "No armour at all: strips of bone-coloured cloth around the wrists, ankles and brow. The Unsworn carry nothing they would have to swear to keep."
max_health = 70.0
max_stamina = 120.0
stamina_regen = 70.0
flasks = 3
flask_heal = 35.0
damage_taken_mult = 1.3
run_speed_mult = 1.15
dodge_stamina = 16.0
parry_window_frames = 10
parry_stamina = 8.0
armor_look = 0
weapon_look = 3
cloth_color = Color(0.420, 0.290, 0.227, 1)
cloth_light_color = Color(0.541, 0.416, 0.322, 1)
accent_color = Color(0.851, 0.816, 0.737, 1)
perks = PackedStringArray("Biggest stamina pool, fastest recovery", "Four-hit fist combo, almost no recovery", "Parry window 10 frames; Hollow Palm riposte hits hardest (84)", "Run speed +15%")
drawbacks = PackedStringArray("Lowest health (70)", "Takes 30% more damage", "Short reach: you must be close", "Smallest heals (35)")
