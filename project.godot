; Engine configuration file.
; THE HOLLOW OATH — Godot 4.3 project.

config_version=5

[application]

config/name="The Hollow Oath"
config/description="A 2D dark-fantasy Soulslike action-platformer."
config/version="0.1.0-m1"
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="TheHollowOath"

[autoload]

Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
InputConfig="*res://autoload/input_config.gd"
InputPrompts="*res://autoload/input_prompts.gd"
GameFeel="*res://autoload/game_feel.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="fractional"
window/vsync/vsync_mode=1

[gui]

theme/default_font_size=8

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player_body"
2d_physics/layer_3="enemy_body"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="interactable"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
2d/default_gravity=900.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.039, 0.035, 0.05, 1)
