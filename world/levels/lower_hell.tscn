[node name="Tablet0" type="Area2D" parent="."]
position = Vector2(580, 480)
script = ExtResource("tablet")
title = "Set Down"
text = "The hand did not drop you. It set you down, the way a hand sets down something it means to come back for. Above you there is no sky. There is a ceiling, and it has been swept."

[node name="ToothTablet" type="Area2D" parent="."]
position = Vector2(790, 480)
script = ExtResource("tablet")
title = "The Keyhole"
text = "A door beneath the stair. No handle, no hinge: only a keyhole the shape of a tooth. Something further in keeps what fits it."

