[node name="CastleTablet" type="Area2D" parent="."]
position = Vector2(1220, 480)
script = ExtResource("tablet")
title = "A Lid"
text = "A castle. Under hell. Nobody built it: it was lowered, the way a lid is lowered over a pot, and whatever is in the pot has been quiet for a very long time. Walk softly. The guards are still on their rounds."

