title = "The Line of Kings"
text = "Eleven kings, eleven niches. The twelfth niche is empty, and carved all around it, as if recently, are fingermarks."

[node name="Tablet1" type="Area2D" parent="."]
position = Vector2(3500, 480)
script = ExtResource("tablet")
title = "A Herald's Roll"
text = "Long live the king. Long live the king. Long live the king. The roll continues for sixty pages, and the king is never named."

[node name="Tablet2" type="Area2D" parent="."]
position = Vector2(5600, 480)
script = ExtResource("tablet")
title = "The Open Sarcophagus"
text = "The lid has been pushed out, not in. Whatever lay here did not need the dead to open it."

