[node name="Tablet2" type="Area2D" parent="."]
position = Vector2(5600, 480)
script = ExtResource("tablet")
title = "The Deep Seam"
text = "The wax seam runs on, white and warm, farther than any lamp. It is not a vein. It is a body."

