[node name="PortraitDowager" type="Area2D" parent="."]
position = Vector2(860, 480)
script = ExtResource("tablet")
title = "Portrait of the Dowager"
text = "A tall woman in grey, painted at the moment before she smiles. The brass plate reads: 'Lady Hollowmere, Patroness of the Candlewrights. She never signed the oath. She is the reason the house still stands.'"

[node name="LastDraft" type="Area2D" parent="."]
position = Vector2(1060, 480)
script = ExtResource("tablet")
title = "The Last Draft"
text = "A page pinned in a glass case. The liturgy of the Hollow Oath, in its final form, with one line struck through and rewritten above it. The new line is the one that turned the oath over. The hand that rewrote it is Ommen's."

