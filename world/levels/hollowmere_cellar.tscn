script = ExtResource("tablet")
title = "The Cellar Book"
text = "Stock-book of Hollowmere. The last entries are in a steady hand: 'One cask, sound. One cask, sour. The key to the Gallery goes on the hook by the stair, as ever.' Under it, in a different ink: 'Grume has taken the key down to the cold end. He says no one is to be let past him. He means it.'"

