position = Vector2(760, 480)
script = ExtResource("tablet")
title = "The Abbess's Stone"
text = "MOTHER CINDER. Abbess here eleven years. 'She kept the censer lit through the Night.' Below, in a rushed hand: 'It is still lit.'"

